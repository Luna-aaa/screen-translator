<Window x:Class="ScreenTranslator.UI.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="屏幕划取翻译 — 最近的翻译"
        Width="620" Height="560" MinWidth="480" MinHeight="360"
        WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei UI, Segoe UI, Microsoft YaHei"
        FontSize="13"
        Background="#FFF4F5F8"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <SolidColorBrush x:Key="Ink" Color="#FF1F2330" />
        <SolidColorBrush x:Key="Muted" Color="#FF6B7280" />
        <SolidColorBrush x:Key="Accent" Color="#FF3D5AFE" />

        <Style x:Key="MinorButton" TargetType="Button">
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="MinWidth" Value="86" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#FFD2D6DE" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <!--
            One card per record. The translation reads first and largest because that is
            what the user came back for; the recognized text sits underneath in a quieter
            colour, for when the translation looks wrong and they need to see why.
        -->
        <DataTemplate x:Key="RecordTemplate">
            <Border Background="White" BorderBrush="#FFE2E5EC" BorderThickness="1"
                    CornerRadius="6" Padding="14,12" Margin="0,0,0,10">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding Header}" FontSize="11.5"
                                   Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="复制译文" MinWidth="0" Padding="10,3"
                                FontSize="11.5" Style="{StaticResource MinorButton}"
                                Tag="{Binding}" Click="CopyRecord_Click" />
                    </Grid>

                    <TextBlock Text="{Binding Record.Translation}" TextWrapping="Wrap"
                               LineHeight="22" Foreground="{StaticResource Ink}" />

                    <Border Margin="0,10,0,0" Background="#FFF7F8FA" BorderBrush="#FFEBEDF2"
                            BorderThickness="1" CornerRadius="4" Padding="10,8">
                        <TextBlock Text="{Binding Record.Original}" TextWrapping="Wrap"
                                   FontSize="12" LineHeight="20"
                                   Foreground="{StaticResource Muted}" />
                    </Border>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ItemsControl rather than ListBox: nothing here is selectable, so selection
             highlighting would only be misleading chrome. -->
        <ScrollViewer Grid.Row="0" Padding="16,16,16,0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock x:Name="EmptyText" Visibility="Collapsed"
                           Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                           Text="还没有记录。框选翻译一次之后就会出现在这里。" />
                <ItemsControl x:Name="RecordList" ItemTemplate="{StaticResource RecordTemplate}" />
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" Background="White" BorderBrush="#FFE2E5EC" BorderThickness="0,1,0,0"
                Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Grid.Column="0" VerticalAlignment="Center"
                           FontSize="11.5" Foreground="{StaticResource Muted}" TextWrapping="Wrap" />
                <Button Grid.Column="1" Content="清空" Style="{StaticResource MinorButton}"
                        Click="Clear_Click" />
                <Button Grid.Column="2" Content="关闭" Margin="8,0,0,0"
                        Style="{StaticResource MinorButton}" IsCancel="True" Click="Close_Click" />
            </Grid>
        </Border>
    </Grid>
</Window>
