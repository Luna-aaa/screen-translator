<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <SelfContained Condition="'$(SelfContained)' == ''">false</SelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>ScreenTranslator</RootNamespace>
    <AssemblyName>ScreenTranslator</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
    <Version>0.1.0</Version>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- Only for the self-test's pixel-by-pixel bitmap comparison. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!--
      WFO0003 tells WinForms apps to move DPI awareness out of the manifest and into
      Application.SetHighDpiMode. That advice does not apply here: this is a WPF app
      that merely borrows NotifyIcon, and the selection overlay needs the process to be
      Per-Monitor-V2 aware from the very first line of native startup - long before any
      managed WinForms call could run. The manifest is the only thing that guarantees that.
    -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Most of the logic worth testing is internal: it is implementation detail for every
      caller except the tests. Widening it to public just to test it would be worse.
    -->
    <InternalsVisibleTo Include="ScreenTranslator.Tests" />
  </ItemGroup>

</Project>
